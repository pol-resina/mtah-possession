#!/bin/sh
# Register every commit pushed to main as a new MLflow model version (see mlops/README.md).
# The code comes from a clean export of the pushed commit, not from the working tree.
# Never blocks the push: if registration fails, it says so and the push goes on.

root=$(git rev-parse --show-toplevel)
python=${MTAH_PYTHON:-$HOME/.venvs/mtah-possession/bin/python}
[ -x "$python" ] || python=python3
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_sha" = "$zero" ] && continue  # deleting main
    tree=$(mktemp -d)
    git archive "$local_sha" | tar -x -C "$tree"
    if [ -f "$tree/mlops/register.py" ]; then
        MTAH_DATA_DIR=${MTAH_DATA_DIR:-$root/data} MLFLOW_DISABLE_AGENT_HINT=1 \
            "$python" "$tree/mlops/register.py" --commit "$local_sha" --store "$root/.mlflow" \
            --message "$(git log -1 --format=%s "$local_sha")" < /dev/null \
            || echo "pre-push: MLflow registration failed for $local_sha; pushing anyway" >&2
    fi
    rm -rf "$tree"
done
exit 0
